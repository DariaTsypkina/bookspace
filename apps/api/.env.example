PORT=8000
DATABASE_URL=postgresql://bookspace:bookspace@localhost:5432/bookspace?schema=public
REDIS_URL=redis://localhost:6379
WEB_URL=http://localhost:3000
SESSION_SECRET=change-me-in-production-use-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_CALLBACK_URL=http://localhost:3000/api/auth/yandex/callback
# OAUTH_TEST_MODE=true  # CI/e2e: mock Google/Yandex without real credentials
JOBS_SYNC=true  # test/e2e: run BullMQ jobs inline without Redis worker
E2E_ADMIN_EMAIL=admin@bookspace.local
E2E_ADMIN_PASSWORD=Admin123!
E2E_USER_EMAIL=user@bookspace.local
E2E_USER_PASSWORD=User123!
