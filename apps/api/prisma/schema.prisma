generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum WorkStatus {
  DRAFT
  PUBLISHED
  MERGED
}

enum CatalogEntityStatus {
  DRAFT
  PUBLISHED
}

model Work {
  id        String     @id @default(uuid())
  slug      String     @unique
  titleRu   String
  titleOrig String?
  status    WorkStatus @default(DRAFT)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, deletedAt])
}

model Author {
  id        String              @id @default(uuid())
  slug      String              @unique
  nameRu    String
  nameOrig  String?
  status    CatalogEntityStatus @default(DRAFT)
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, deletedAt])
}

model Series {
  id        String              @id @default(uuid())
  slug      String              @unique
  nameRu    String
  nameOrig  String?
  status    CatalogEntityStatus @default(DRAFT)
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, deletedAt])
}

model Character {
  id        String              @id @default(uuid())
  slug      String              @unique
  nameRu    String
  nameOrig  String?
  status    CatalogEntityStatus @default(DRAFT)
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, deletedAt])
}

model World {
  id        String              @id @default(uuid())
  slug      String              @unique
  nameRu    String
  nameOrig  String?
  status    CatalogEntityStatus @default(DRAFT)
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, deletedAt])
}

model Place {
  id        String              @id @default(uuid())
  slug      String              @unique
  nameRu    String
  nameOrig  String?
  status    CatalogEntityStatus @default(DRAFT)
  deletedAt DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([status, deletedAt])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?
  slug         String    @unique
  role         UserRole  @default(USER)
  isPremium    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     Account[]
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}
