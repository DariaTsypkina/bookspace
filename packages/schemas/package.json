{
  "name": "@bookspace/schemas",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "default": "./dist/search.js"
    },
    "./admin-context": {
      "types": "./dist/admin-context.d.ts",
      "default": "./dist/admin-context.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    }
  },
  "scripts": {
    "build": "pnpm -C ../.. --filter api exec tsc -p ../../packages/schemas/tsconfig.build.json",
    "lint": "echo \"No lint configured for @bookspace/schemas\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"No tests configured for @bookspace/schemas\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
